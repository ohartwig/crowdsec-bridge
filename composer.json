{
    "name": "koh/crowdsec-bridge",
    "description": "TYPO3 14 backend module for the CrowdSec Local API (LAPI): active decisions, alerts, IP quick-check and LAPI heartbeat; adding and deleting decisions with a full sys_log audit.",
    "license": "MIT",
    "type": "typo3-cms-extension",
    "keywords": [
        "typo3",
        "typo3-cms-extension",
        "crowdsec",
        "security",
        "lapi",
        "backend"
    ],
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "homepage": "https://ole-hartwig.eu/open-source",
    "support": {
        "issues": "https://github.com/ohartwig/crowdsec-bridge/issues",
        "source": "https://github.com/ohartwig/crowdsec-bridge",
        "security": "https://github.com/ohartwig/crowdsec-bridge/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "moselwal/keyvalue-store": "^4.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^2.0.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.2",
        "koh/dev-typo3": "^1.0"
    },
    "suggest": {
        "moselwal/keyvalue-store": "Optional Decision cache backend via Redis/Valkey"
    },
    "autoload": {
        "psr-4": {
            "Koh\\CrowdsecBridge\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\CrowdsecBridge\\Tests\\": "Tests/"
        },
        "files": [
            ".Stubs/KeyValueStoreInterface.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "crowdsec_bridge",
            "web-dir": ".Build/Web"
        }
    },
    "scripts": {
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "phpstan": "phpstan analyse Classes Tests --memory-limit=512M",
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit",
        "test:contract": "phpunit -c Tests/ContractTests.xml",
        "test:functional": "phpunit -c Tests/phpunit.xml --testsuite Functional"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "moselwal/*"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/dev*"
            ]
        }
    ]
}
